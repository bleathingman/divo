{
  "name": "divo",
  "version": "1.5.0",
  "description": "Divo Browser",
  "author": "Divh",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "set CSC_IDENTITY_AUTO_DISCOVERY=false && electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^42.1.0",
    "electron-builder": "^26.8.1"
  },
  "overrides": {
    "tar": "^7.5.12"
  },
  "build": {
    "appId": "com.divh.divo",
    "productName": "Divo",
    "copyright": "Divh",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "ext-sw-polyfill.js",
      "renderer/**/*",
      "assets/**/*",
      "node_modules/electron-chrome-web-store/dist/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis",     "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] },
        { "target": "appx",     "arch": ["x64"] }
      ],
      "artifactName": "${productName}.${version}.${ext}",
      "icon": "assets/icon.png",
      "protocols": [
        {
          "name": "Divo Browser",
          "schemes": [
            "http",
            "https"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "html",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        },
        {
          "ext": "htm",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        },
        {
          "ext": "xhtml",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        },
        {
          "ext": "shtml",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        },
        {
          "ext": "xht",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        }
      ]
    },
    "appx": {
      "identityName": "Divh.Divo",
      "publisher": "CN=27A3E3B0-E0A9-4BCF-9853-BE2D540440DF",
      "publisherDisplayName": "Divh",
      "applicationId": "Divo",
      "backgroundColor": "#111113",
      "artifactName": "${productName}.${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Divo",
      "artifactName": "${productName}.Setup.${version}.${ext}"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Network"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.productivityapps",
      "protocols": [
        {
          "name": "Divo Browser",
          "schemes": [
            "http",
            "https"
          ]
        }
      ],
      "fileAssociations": [
        {
          "ext": "html",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        },
        {
          "ext": "htm",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        },
        {
          "ext": "xhtml",
          "name": "Divo HTML Document",
          "description": "Ouvrir avec Divo"
        }
      ]
    }
  },
  "dependencies": {
    "electron-chrome-web-store": "^0.13.0"
  }
}
